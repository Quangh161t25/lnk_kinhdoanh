# Sao chép file này thành .env.local khi chạy ở máy, hoặc khai báo trong
# Vercel > Project > Settings > Environment Variables khi deploy.
# KHÔNG đặt tiền tố VITE_ cho các biến này (VITE_* sẽ bị lộ ra trình duyệt).

# ID của Google Spreadsheet (đoạn giữa /d/ và /edit trong URL)
SPREADSHEET_ID=

# Email của service account (dạng xxx@yyy.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private key của service account, giữ nguyên các ký tự \n trên một dòng
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Chuỗi ngẫu nhiên >= 32 ký tự dùng để ký cookie đăng nhập
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
